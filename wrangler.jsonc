{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdc-gestionale",
  "minify": true,
  "keep_names": false,
  "main": "custom-worker.mjs",
  "triggers": { "crons": ["0 6 * * *", "*/5 * * * *"] },
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "name": "mdc-gestionale-staging",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "vars": {
        "INVOICING_PROVIDER": "mock",
        "EMAIL_MODE": "log",
        "IMPORT_RETENTION_DAYS": "90",
      },
      "triggers": { "crons": ["0 6 * * *", "*/5 * * * *"] },
    },
    "production": {
      "name": "mdc-gestionale-production",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "vars": {
        "INVOICING_PROVIDER": "fic",
        "EMAIL_MODE": "resend",
        "IMPORT_RETENTION_DAYS": "90",
      },
      "triggers": { "crons": ["0 6 * * *", "*/5 * * * *"] },
    },
  },
}
