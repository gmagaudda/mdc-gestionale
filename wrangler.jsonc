{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdc-gestionale",
  "minify": true,
  "keep_names": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
  },
}
