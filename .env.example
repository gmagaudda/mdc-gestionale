NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3100
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_MODE=log
CRON_SECRET=
IMPORT_RETENTION_DAYS=90
INVOICING_PROVIDER=mock
FIC_ACCESS_TOKEN=
# Explicit brand UUID -> { companyId, supplierVat, numeration, vatIds } map. Server only.
