FIC_REFRESH_TOKEN=
SENTRY_DSN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL (https) or mailto address of the operator. Server only.
VAPID_SUBJECT=

# Random secret with at least 32 characters for signed mock callbacks.
INVOICING_WEBHOOK_SECRET=

# Optional separate random HMAC key (32+ characters); otherwise server role key is used.
RATE_LIMIT_SECRET=
