{
  "name": "mdc-gestionale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "supabase:test": "supabase test db",
    "types": "supabase gen types typescript --local > lib/supabase/types.ts",
    "prepare": "husky",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:tokens": "node scripts/check-tokens.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:orders:concurrency": "node scripts/test-order-concurrency.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@opennextjs/cloudflare": "1.20.10",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.25.0"
